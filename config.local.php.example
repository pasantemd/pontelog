/**
 * Copia este archivo a config.local.php y completa tus datos SMTP.
 * config.local.php no se sube a git (.gitignore).
 *
 * Ejemplo Gmail / Google Workspace:
 *   host smtp.gmail.com, puerto 587, secure tls
 *   usa una "Contraseña de aplicación", no la clave normal.
 *
 * Ejemplo hosting cPanel típico:
 *   host mail.tudominio.com, puerto 465 + ssl, o 587 + tls
 */
