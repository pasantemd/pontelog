/**
 * Copia este archivo a config.local.php y completa tus datos SMTP.
 * config.local.php no se sube a git (.gitignore).
 *
 * Dominio: pontelog.com (cPanel)
 *
 * Si aparece "Could not connect to SMTP host", prueba en este orden:
 * 1) localhost + puerto 587 + tls  (recomendado en el mismo servidor)
 * 2) localhost + puerto 465 + ssl
 * 3) mail.pontelog.com + 465 + ssl
 * 4) mail.pontelog.com + 587 + tls
 *
 * data_dir debe estar FUERA de la carpeta pública del sitio.
 */
return [
    'mail_enabled' => true,
    'contact_email' => 'info@pontelog.com', // destinatario principal
    'mail_copy' => 'copia@pontelog.com',    // copia visible (CC); varios: 'a@x.com, b@y.com'
    'mail_from' => 'info@pontelog.com',
    'mail_from_name' => 'Pontelog',
    'smtp_host' => 'localhost',
    'smtp_port' => 587,
    'smtp_user' => 'info@pontelog.com',
    'smtp_pass' => 'TU_CLAVE_SMTP',
    'smtp_secure' => 'tls', // tls | ssl | '' (sin cifrado)
    'mail_debug' => true, // pon false cuando el correo ya funcione
    'data_dir' => '/home/TU_USUARIO/pontelog-data',

    // Boletín → Mautic (crea un formulario de suscripción publicado y pega su ID)
